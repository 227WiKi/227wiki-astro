---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MemberCard from "@/components/wiki/MemberCard.astro";
import Breadcrumbs from "@/components/wiki/common/Breadcrumbs.astro";
import PageHeader from "@/components/wiki/common/PageHeader.astro";

const members = await getCollection("members");
members.sort((a, b) => {
  const nameA = a.data.nameZh ?? a.data.nameJa;
  const nameB = b.data.nameZh ?? b.data.nameJa;
  return nameA.localeCompare(nameB, "zh-CN");
});
---

<BaseLayout title="Member" description="22/7 成员索引。" wide>
  <div class="flex flex-col gap-8">
    <Breadcrumbs items={[{ label: "Member", href: "/member/" }]} />
    <PageHeader title="Member" />

    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4 lg:gap-6">
      {members.map((member) => <MemberCard member={member} />)}
    </div>
  </div>
</BaseLayout>
