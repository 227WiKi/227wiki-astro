---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WikiArticleLayout from "@/components/wiki/article/WikiArticleLayout.astro";
import ContextNav from "@/components/wiki/article/ContextNav.astro";
import FloatingTOC from "@/components/wiki/article/FloatingTOC.astro";
import MemberHitokoto from "@/components/wiki/member/MemberHitokoto.astro";
import MemberChronology from "@/components/wiki/member/MemberChronology.astro";
import { MemberBreadcrumbs } from "@/components/wiki/member/MemberBreadcrumbs";
import MemberInfobox from "@/components/wiki/member/MemberInfobox.astro";
import WikiArticle from "@/components/wiki/WikiArticle.astro";
import { getMemberSignatureSvg } from "@/lib/signatures";

interface Props {
  member: CollectionEntry<"members">;
}

export async function getStaticPaths() {
  const members = await getCollection("members");

  return members.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const displayName = member.data.nameZh ?? member.data.nameJa;
const primaryName = member.data.nameJa;
const { Content, headings } = await render(member);
const siblings = await getCollection("members");
const contextItems = siblings
  .sort((a, b) => (a.data.nameZh ?? a.data.nameJa).localeCompare(b.data.nameZh ?? b.data.nameJa, "zh-CN"))
  .map((entry) => ({
    label: entry.data.nameZh ?? entry.data.nameJa,
    href: `/member/${entry.id}/`,
    current: entry.id === member.id,
  }));
const signatureSvg = getMemberSignatureSvg(member.data.signature);
---

<BaseLayout title={displayName} description={`${displayName}的 22/7 成员资料。`} wide>
  <WikiArticleLayout infoboxWidth="wide">
    <ContextNav slot="context" title="成员" collapsedLabel="其他成员" items={contextItems} />
    <div slot="header" class="min-w-0">
      <h1 class="sr-only">{primaryName}</h1>
      <MemberBreadcrumbs
        client:load
        currentName={displayName}
        members={contextItems}
        signatureSvg={signatureSvg}
      />
    </div>
    <MemberInfobox slot="infobox" member={member} />
    <WikiArticle>
      <MemberHitokoto
        hitokoto={member.data.hitokoto}
        themeColor={member.data.themeColor}
        signature={member.data.signature}
      />
      <MemberChronology
        timeline={member.data.timeline}
        themeColor={member.data.themeColor}
      />
      <Content />
    </WikiArticle>
    <FloatingTOC slot="toc" headings={headings} />
  </WikiArticleLayout>
</BaseLayout>
