---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/wiki/common/PageHeader.astro";
import SectionCard from "@/components/wiki/common/SectionCard.astro";
import { navigationGroups, siteName } from "@/config/site";
---
<BaseLayout title={siteName} description="22/7 相关资料的非官方粉丝维基与档案。">
  <div class="flex flex-col gap-10">
    <PageHeader title={siteName} description="22/7 相关资料的非官方粉丝维基与档案。" />

    <section id="sections" aria-labelledby="sections-heading" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <p class="text-sm font-medium text-(--wiki-brand)">Browse</p>
        <h2 id="sections-heading" class="font-heading text-2xl font-semibold tracking-tight">内容分类</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {navigationGroups.map((group) => <SectionCard group={group} />)}
      </div>
    </section>
  </div>
</BaseLayout>
