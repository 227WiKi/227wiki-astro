---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WikiArticleLayout from "@/components/wiki/article/WikiArticleLayout.astro";
import ContextNav from "@/components/wiki/article/ContextNav.astro";
import FloatingTOC from "@/components/wiki/article/FloatingTOC.astro";
import Breadcrumbs from "@/components/wiki/common/Breadcrumbs.astro";
import PageHeader from "@/components/wiki/common/PageHeader.astro";
import WikiArticle from "@/components/wiki/WikiArticle.astro";
import SongInfobox from "@/components/wiki/song/SongInfobox.astro";
import ListeningLinks from "@/components/wiki/song/ListeningLinks.astro";
import SongVideos from "@/components/wiki/song/SongVideos.astro";
import LyricsSection from "@/components/wiki/song/LyricsSection.astro";
import SongReleaseList from "@/components/wiki/song/SongReleaseList.astro";
import SongLiveHistory from "@/components/wiki/song/SongLiveHistory.astro";
import { assertSongPerformerReferences, assertSongReferences, getLiveAppearancesForSong, releasesForSong } from "@/lib/songs";
import { buildSongIndex, songContextItems } from "@/lib/song-index";
import { songInfoboxFacts } from "@/lib/song-infobox";
import { assertSongLyrics } from "@/lib/song-lyrics";

interface Props { song: CollectionEntry<"songs">; }

export async function getStaticPaths() {
  const songs = await getCollection("songs");
  assertSongLyrics(await getCollection("songLyrics"), songs);
  assertSongReferences(await getCollection("releases"), songs);
  assertSongPerformerReferences(songs, await getCollection("members"));
  return songs.map((song) => ({ params: { slug: song.id }, props: { song } }));
}

const { song } = Astro.props;
const { data } = song;
const title = data.titleJa;
const { Content, headings } = await render(song);
const lyrics = (await getCollection("songLyrics")).filter(({ data }) => data.song === song.id);
const allReleases = await getCollection("releases");
// A short window around this song plus a link to the Song Index, never every song.
const indexEntries = buildSongIndex(await getCollection("songs"), allReleases);
const contextItems = songContextItems(indexEntries, song.id);
// Same entry as the Song Index, so both show the same first release.
const infoboxFacts = songInfoboxFacts(indexEntries.find(({ id }) => id === song.id)!, allReleases, new Set((await getCollection("members")).map(({ id }) => id)));
const releases = releasesForSong(allReleases, song.id);
const appearances = getLiveAppearancesForSong(await getCollection("liveEvents"), song.id);
const tocItems = [
  ...headings,
  { slug: "listening", text: "试听", depth: 2 },
  ...(data.videos.length > 0 ? [{ slug: "videos", text: "视频", depth: 2 }] : []),
  { slug: "lyrics", text: "歌词", depth: 2 },
  { slug: "releases", text: "收录作品", depth: 2 },
  ...(appearances.length > 0 ? [{ slug: "live-history", text: "Live 演出历史", depth: 2 }] : []),
  ...(lyrics.length > 0 || data.references.length > 0 ? [{ slug: "song-references", text: "参考资料与官方链接", depth: 2 }] : []),
];
---

<BaseLayout title={title} description={`${data.titleJa}的歌曲资料与收录作品。`} wide>
  <WikiArticleLayout>
    <ContextNav slot="context" title="歌曲" collapsedLabel="其他歌曲" items={contextItems} />
    <Fragment slot="header">
      <Breadcrumbs items={[{ label: "Discography", href: "/discography/" }, { label: "歌曲", href: "/discography/songs/" }, { label: title }]} />
      <PageHeader eyebrow="Song" title={title} lang="ja" />
    </Fragment>
    <SongInfobox slot="infobox" song={song} facts={infoboxFacts} />
    <WikiArticle>
      <Content />
      <ListeningLinks links={data.listeningLinks} songTitle={title} />
      <SongVideos videos={data.videos} />
      <LyricsSection entries={lyrics} />
      <SongReleaseList releases={releases} />
      <SongLiveHistory appearances={appearances} />
      {(lyrics.length > 0 || data.references.length > 0) && <section aria-labelledby="song-references">
        <h2 id="song-references">参考资料与官方链接</h2>
        <ul>{data.references.map((reference) => <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.label}</a></li>)}</ul>
        <ul>{lyrics.map(({ data }) => <li>
          <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer">{data.sourceLabel}</a>
          <p>{data.attribution}</p>
        </li>)}</ul>
      </section>}
    </WikiArticle>
    <FloatingTOC slot="toc" headings={tocItems} />
  </WikiArticleLayout>
</BaseLayout>
