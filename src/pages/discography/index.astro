---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/wiki/common/Breadcrumbs.astro";
import PageHeader from "@/components/wiki/common/PageHeader.astro";
import ReleaseCard from "@/components/wiki/release/ReleaseCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { sectionPages } from "@/config/site";

const section = sectionPages.discography;
const releases = await getCollection("releases");
const songCount = (await getCollection("songs")).length;
const groups = [
  { type: "single", title: "Single" },
  { type: "album", title: "Album" },
] as const;
---

<BaseLayout title={section.title} description={section.description} wide>
  <div class="flex flex-col gap-8">
    <Breadcrumbs items={[{ label: section.title }]} />
    <PageHeader title={section.title} />

    <div class="flex flex-col gap-10 sm:gap-12">
      <section aria-labelledby="songs" class="flex min-w-0 flex-col gap-4">
        <h2 id="songs" class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">Song</h2>
        <p class="max-w-2xl">按歌名、类型和首次发行时间浏览已收录的 {songCount} 首歌曲。</p>
        <a href="/discography/songs/" class:list={[buttonVariants({ variant: "outline" }), "self-start"]}>浏览全部歌曲</a>
      </section>
      {groups.map((group) => {
        const groupReleases = releases
          .filter(({ data }) => data.releaseType === group.type)
          .sort((a, b) => a.data.releaseNumber - b.data.releaseNumber);

        if (groupReleases.length === 0) return null;

        return (
          <section aria-labelledby={group.type} class="flex min-w-0 flex-col gap-5">
            <h2 id={group.type} class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">
              {group.title}
            </h2>
            <div class="cd-wall-grid grid grid-cols-2 gap-4 sm:gap-4 md:grid-cols-3 md:gap-5 lg:grid-cols-4 xl:grid-cols-5 lg:gap-5 xl:gap-6 items-start">
              {groupReleases.map((release) => <ReleaseCard release={release} />)}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .cd-wall-grid {
    --grid-gap: 1rem;
  }
  @media (min-width: 640px) {
    .cd-wall-grid {
      --grid-gap: 1rem;
    }
  }
  @media (min-width: 768px) {
    .cd-wall-grid {
      --grid-gap: 1.25rem;
    }
  }
  @media (min-width: 1280px) {
    .cd-wall-grid {
      --grid-gap: 1.5rem;
    }
  }
</style>
