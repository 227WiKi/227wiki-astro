---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CossDialogProbe from "@/components/prototype/CossDialogProbe";
---
<BaseLayout title="UI Lab" description="Coss Dialog 在 Astro 中的 isolated React island 验证。">
  <div class="flex flex-col items-start gap-4">
    <h1 class="font-heading text-3xl font-semibold tracking-tight">UI Lab</h1>
    <p class="text-muted-foreground">Coss Dialog · isolated React island</p>
    <CossDialogProbe client:idle />
    <noscript>此测试需要启用 JavaScript 才能打开 Dialog。普通 Wiki 页面无需 JavaScript。</noscript>
  </div>
</BaseLayout>
