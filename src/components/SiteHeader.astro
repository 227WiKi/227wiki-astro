---
import { githubUrl, siteName } from "@/config/site";
---
<header class="border-b">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-semibold" aria-label={siteName + " v2 首页"}>
      <span class="text-(--wiki-brand)">{siteName}</span> <span class="text-muted-foreground">v2</span>
    </a>
    <nav aria-label="主导航" class="flex items-center gap-6 text-sm">
      <a href="/" class="hover:underline underline-offset-4">Home</a>
      <a href="/#sections" class="hover:underline underline-offset-4">Sections</a>
      <a href={githubUrl} class="hover:underline underline-offset-4">GitHub</a>
    </nav>
  </div>
</header>
