---
import { githubUrl, navigationGroups, siteName } from "@/config/site";

const currentPath = Astro.url.pathname;
const isPathActive = (path: string) => currentPath === path || currentPath.startsWith(path);
const isGroupActive = (paths: readonly string[]) => paths.some(isPathActive);
const navLinkClass =
  "rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring";
---

<header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="shrink-0 rounded-md font-heading text-lg font-semibold tracking-tight text-(--wiki-brand) outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label={`${siteName} 首页`}
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      {siteName}
    </a>

    <div class="hidden min-w-0 flex-1 items-center justify-end gap-2 md:flex">
      <nav aria-label="主导航">
        <ul class="flex items-center gap-1">
          {navigationGroups.map((group) => {
            const active = isGroupActive(group.links.map((link) => link.path));

            return (
              <li>
                {group.links.length > 1 ? (
                  <details class="group relative">
                    <summary
                      class:list={[
                        navLinkClass,
                        "flex cursor-pointer list-none items-center gap-1.5 [&::-webkit-details-marker]:hidden",
                        active && "bg-accent text-foreground",
                      ]}
                      aria-current={active ? "true" : undefined}
                    >
                      {group.label}
                      <span aria-hidden="true" class="text-xs transition-transform group-open:rotate-180">⌄</span>
                    </summary>
                    <div class="absolute top-[calc(100%+0.5rem)] left-0 w-56 rounded-xl border bg-popover p-2 text-popover-foreground shadow-lg">
                      <ul class="flex flex-col gap-1">
                        {group.links.map((link) => (
                          <li>
                            <a
                              href={link.path}
                              class:list={[navLinkClass, "block", isPathActive(link.path) && "bg-accent text-foreground"]}
                              aria-current={isPathActive(link.path) ? "page" : undefined}
                            >
                              {link.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                ) : (
                  <a
                    href={group.links[0].path}
                    class:list={[navLinkClass, active && "bg-accent text-foreground"]}
                    aria-current={active ? "page" : undefined}
                  >
                    {group.label}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </nav>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 rounded-lg border px-3 py-2 text-sm font-medium outline-none transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring"
      >
        GitHub
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-lg border px-3 text-sm font-medium outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <div class="absolute top-[calc(100%+0.5rem)] right-0 max-h-[calc(100vh-5rem)] w-[min(calc(100vw-2rem),20rem)] overflow-y-auto rounded-xl border bg-popover p-3 text-popover-foreground shadow-lg">
        <nav aria-label="移动端主导航">
          <ul class="flex flex-col gap-2">
            {navigationGroups.map((group) => (
              <li>
                {group.links.length > 1 ? (
                  <div class="rounded-lg bg-muted/50 p-2">
                    <p class="px-2 py-1 text-xs font-semibold text-muted-foreground">{group.label}</p>
                    <ul class="flex flex-col gap-1">
                      {group.links.map((link) => (
                        <li>
                          <a
                            href={link.path}
                            class:list={[navLinkClass, "block min-h-11 py-3", isPathActive(link.path) && "bg-accent text-foreground"]}
                            aria-current={isPathActive(link.path) ? "page" : undefined}
                          >
                            {link.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <a
                    href={group.links[0].path}
                    class:list={[navLinkClass, "block min-h-11 py-3", isPathActive(group.links[0].path) && "bg-accent text-foreground"]}
                    aria-current={isPathActive(group.links[0].path) ? "page" : undefined}
                  >
                    {group.label}
                  </a>
                )}
              </li>
            ))}
          </ul>

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 block min-h-11 rounded-lg border px-3 py-3 text-sm font-medium outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring"
          >
            GitHub
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>
