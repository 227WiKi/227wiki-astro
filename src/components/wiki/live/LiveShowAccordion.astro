---
import type { ShowView } from "@/lib/live-detail";
import { LiveSetlist } from "./LiveSetlist";
interface Props { shows: ShowView[]; }
const { shows } = Astro.props;
---
<div class="flex min-w-0 flex-col gap-4">
  {shows.map((show) => (
    show.setlist?.some((entry) => entry.type === "song" && entry.performers?.length)
      ? <LiveSetlist client:load show={show} collapsible />
      : <LiveSetlist show={show} collapsible />
  ))}
</div>

<script>
  // Native fragment navigation scrolls to the Show; only opening its <details> needs help.
  function openTargetShow() {
    let id: string;
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement && target.classList.contains("live-show")) target.open = true;
  }
  openTargetShow();
  window.addEventListener("hashchange", openTargetShow);
</script>
