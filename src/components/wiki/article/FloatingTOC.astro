---
import ArticleTOC, { type ArticleTOCItem } from "./ArticleTOC.astro";

interface Props {
  headings: readonly ArticleTOCItem[];
}
const { headings } = Astro.props;
const hasHeadings = headings.some(({ depth }) => depth === 2 || depth === 3);
---

{hasHeadings && (
  <details class="floating-toc fixed z-30">
    <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border bg-popover px-4 py-2.5 text-sm font-medium text-popover-foreground shadow-md outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden">
      <span aria-hidden="true">≡</span> 本页目录
    </summary>
    <div class="toc-panel absolute right-0 bottom-[calc(100%+0.75rem)] w-72 max-w-[calc(100vw-3rem)] overflow-y-auto overscroll-contain rounded-xl border bg-popover p-2 text-popover-foreground shadow-lg">
      <ArticleTOC headings={headings} />
    </div>
  </details>
)}

<style>
  .floating-toc {
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
  }
  .toc-panel {
    max-height: min(28rem, calc(100dvh - 10rem - env(safe-area-inset-bottom)));
  }
  /* Leave a docking area below footer links on pages that have a TOC. */
  :global(body:has(.floating-toc) footer) {
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
  }
</style>
