---
import TrackList from "./TrackList.astro";
import { editionAnchor, type ReleaseEdition } from "@/lib/releases";
import { resourceUrl } from "@/lib/assets";

interface Props { edition: ReleaseEdition; defaultOpen?: boolean; }
const { edition, defaultOpen = false } = Astro.props;
const anchor = editionAnchor(edition.id);
---

<details open={defaultOpen} class="edition-section group mt-6 min-w-0 border-t">
  <summary id={anchor} class="flex cursor-pointer list-none items-start gap-3 rounded-lg py-4 outline-none transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
    <h3 class="flex min-w-0 flex-1 items-start gap-3">
      <span aria-hidden="true" class="mt-1 shrink-0 text-sm group-open:rotate-90">▶</span>
      <span class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <span>{edition.name}</span>
        {edition.catalogNumber && <span class="text-sm font-normal text-muted-foreground">{edition.catalogNumber}</span>}
      </span>
    </h3>
  </summary>
  <div class="flex min-w-0 flex-col gap-6 pb-4">
    {edition.cover && <img src={resourceUrl(edition.cover)} alt={`${edition.name}封面`} width="160" height="160" loading="lazy" decoding="async" class="size-28 rounded-lg border object-cover" />}
    {edition.audioDiscs.map((disc, index) => (
      <section aria-labelledby={`${anchor}-disc-${index + 1}`} class="min-w-0">
        <h4 id={`${anchor}-disc-${index + 1}`} class="mb-3 font-heading text-base font-semibold">{disc.label ?? `Disc ${index + 1}`}</h4>
        <TrackList tracks={disc.tracks} label={`${edition.name} · ${disc.label ?? `Disc ${index + 1}`}`} />
      </section>
    ))}
    {edition.bonusMedia?.map((media, index) => (
      <section aria-labelledby={`${anchor}-bonus-${index + 1}`} class="min-w-0 rounded-xl border bg-muted/30 px-4 py-3 text-sm">
        <h4 id={`${anchor}-bonus-${index + 1}`} class="font-heading text-base font-semibold">{media.medium === "dvd" ? "DVD" : "Blu-ray"}{media.label && ` · ${media.label}`}</h4>
        <ul>{media.items.map((item) => <li>{item}</li>)}</ul>
      </section>
    ))}
  </div>
</details>

<style>
  .edition-section > summary { scroll-margin-top: 6rem; }
  .edition-section > summary h3 { margin: 0; }
</style>
