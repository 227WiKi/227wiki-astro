---
import type { CollectionEntry } from "astro:content";
import Infobox from "@/components/wiki/article/Infobox.astro";
import MetadataList from "@/components/wiki/common/MetadataList.astro";
import MetadataRow from "@/components/wiki/common/MetadataRow.astro";
import { resourceUrl } from "@/lib/assets";
import { releaseLabel } from "@/lib/releases";

interface Props { release: CollectionEntry<"releases">; }
const { data } = Astro.props.release;
const title = data.titleZh ?? data.titleJa;
---

<Infobox label={`${title}发行资料`}>
  {data.cover && <div class="wiki-inset-media"><img src={resourceUrl(data.cover)} alt={title} width="320" height="320" decoding="async" class="aspect-square w-full rounded-[var(--wiki-media-radius)] object-cover" /></div>}
  <MetadataList>
    {data.titleZh && data.titleZh !== data.titleJa && <MetadataRow label="原题">{data.titleJa}</MetadataRow>}
    <MetadataRow label="类型">{data.releaseType === "single" ? "单曲" : "专辑"}</MetadataRow>
    <MetadataRow label="序号">{releaseLabel(data)}</MetadataRow>
    <MetadataRow label="发行日"><time datetime={data.releaseDate}>{data.releaseDate}</time></MetadataRow>
    {data.label && <MetadataRow label="唱片公司">{data.label}</MetadataRow>}
    {data.producer && <MetadataRow label="制作人">{data.producer}</MetadataRow>}
  </MetadataList>
</Infobox>
