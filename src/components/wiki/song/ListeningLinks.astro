---
import type { SongData } from "@/lib/songs";
import { prepareListeningLinks, preferredListeningEntry } from "@/lib/listening";
import { segmentedControlItemVariants, segmentedControlRootClassName } from "@/lib/segmented-control";
// Follows docs/ui-rules.md; listed in RULED_FILES in tests/ui-rules.test.mjs.
interface Props { links: SongData["listeningLinks"]; songTitle: string; id?: string; }
const { links, songTitle, id = "listening" } = Astro.props;
const entries = prepareListeningLinks(links);
const playable = entries.filter((link) => link.embed)
  .sort((a, b) => Number(b.provider === "apple-music") - Number(a.provider === "apple-music"));
const preferred = preferredListeningEntry(entries);
---

<section aria-labelledby={id}>
  <h2 id={id}>试听</h2>
  {entries.length > 0 ? (
    <listening-switcher data-song-title={songTitle} class="block min-w-0">
      {playable.length > 1 && <div data-platform-switcher hidden>
        <div role="radiogroup" aria-label="试听平台" class={segmentedControlRootClassName}>
          <span data-listening-indicator aria-hidden="true" class="pointer-events-none absolute left-0 top-0 rounded-md bg-background shadow-sm/5 transition-none dark:bg-input"></span>
          {playable.map((link, index) => (
            <label class={segmentedControlItemVariants({ size: "default", className: "z-10 data-checked:text-foreground has-[:focus-visible]:outline-ring" })}
              data-checked={link === preferred ? "" : undefined}>
              <input type="radio" name={`${id}-platform`} value={index} class="sr-only"
                checked={link === preferred} data-listening-choice data-provider={link.provider}
                data-label={link.label} data-embed-url={link.embed!.url} aria-controls={`${id}-player`} />
              {link.label}
            </label>
          ))}
        </div>
      </div>}
      {preferred?.embed && <div id={`${id}-player`} data-player-mount class:list={["min-w-0", playable.length > 1 && "mt-4"]}>
        <iframe src={preferred.embed.url} title={`${songTitle} — ${preferred.label} 试听播放器`}
          width="100%" height={preferred.embed.height} class="block w-full rounded-lg border-0" loading="lazy"
          allow="encrypted-media; fullscreen; picture-in-picture" allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox={preferred.provider === "apple-music" ? "allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation" : undefined} />
      </div>}
      {entries.some((link) => !link.embed) && <div class="mt-3 flex flex-wrap gap-3">
        {entries.filter((link) => !link.embed).map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
        ))}
      </div>}
      <noscript>
        <div class="mt-3 flex flex-wrap gap-3">
          {playable.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </div>
      </noscript>
    </listening-switcher>
  ) : <p class="text-sm text-muted-foreground">试听链接暂未收录。<a href="/discography/">浏览收录作品</a></p>}
</section>

<script>
  import "@/scripts/listening-switcher";
</script>
