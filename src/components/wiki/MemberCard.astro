---
import type { CollectionEntry } from "astro:content";
import { resourceUrl } from "@/lib/assets";
import { getMemberThemeStyle } from "@/lib/member-theme";
import MemberSignature from "@/components/wiki/member/MemberSignature.astro";

interface Props {
  member: CollectionEntry<"members">;
}

const { member } = Astro.props;
const { data } = member;

// Photo resolution: prefer dedicated avatar, then fallback to officialPhotos
const photoPath = data.avatar ?? data.officialPhotos?.[0]?.path;
const photoUrl = photoPath ? resourceUrl(photoPath) : undefined;

// Theme style
const memberThemeStyle = getMemberThemeStyle(data.themeColor);
const cardStyle = [
  memberThemeStyle,
  "--card-surface: var(--member-frame-bg, var(--card))",
  "--card-surface-hover: var(--member-header-bg, var(--card))",
]
  .filter(Boolean)
  .join(";");

// Identity text
const primaryName = data.nameJa ?? data.nameZh ?? "";
const roleName = data.characterRole?.name;
const hasSignature = Boolean(data.signature);
---

<article class="h-full">
  <a
    href={`/member/${member.id}/`}
    class="group member-card-link relative flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--member-inner-border,var(--border))] bg-[var(--card-surface)] transition-[border-color,background-color] duration-200 hover:border-[var(--member-frame-border,var(--border))] hover:bg-[var(--card-surface-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    style={cardStyle}
  >
    {/* 1:1 Square Avatar Container */}
    <div class="relative aspect-square w-full overflow-hidden bg-muted/40">
      {photoUrl ? (
        <img
          src={photoUrl}
          alt={primaryName}
          class="h-full w-full object-cover object-top transition-transform duration-300 ease-out group-hover:scale-[1.01]"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-muted/20 text-muted-foreground/30">
          <span class="text-4xl font-semibold select-none">
            {primaryName.slice(0, 1)}
          </span>
        </div>
      )}

      {/* Surface-driven bottom gradient fade bridging avatar into identity surface */}
      {photoUrl && (
        <div
          class="avatar-transition-fade pointer-events-none absolute inset-x-0 bottom-0 h-7 sm:h-11"
          aria-hidden="true"
        />
      )}
    </div>

    {/* Low-overlap identity area */}
    <div class="relative -mt-3 flex flex-1 flex-col justify-center px-4 pb-4 pt-1">
      <div
        class:list={[
          "relative z-10 min-h-[2.75rem] sm:min-h-[3rem] items-center",
          hasSignature
            ? "grid grid-cols-[minmax(0,1fr)_auto] gap-2 sm:gap-3"
            : "flex flex-col justify-center",
        ]}
      >
        {/* Left: Member primary name & character role */}
        <div class="min-w-0 flex flex-col justify-center">
          <h2 class="truncate text-base font-semibold tracking-tight text-foreground sm:text-lg">
            {primaryName}
          </h2>
          {roleName && (
            <p class="truncate text-xs text-muted-foreground sm:text-sm">
              {roleName} 役
            </p>
          )}
        </div>

        {/* Right: Signature secondary identity mark */}
        {hasSignature && data.signature && (
          <div
            class="flex shrink-0 items-center justify-end text-foreground opacity-[0.18] dark:opacity-[0.22] pointer-events-none select-none"
            aria-hidden="true"
          >
            <MemberSignature
              signature={data.signature}
              class="h-11 max-w-[56px] sm:h-13 sm:max-w-[70px] [&>svg]:h-full [&>svg]:w-auto"
            />
          </div>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  .member-card-link:hover {
    --card-surface: var(--member-header-bg, var(--card));
  }

  .avatar-transition-fade {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--card-surface) 12%, transparent) 35%,
      color-mix(in srgb, var(--card-surface) 65%, transparent) 70%,
      var(--card-surface) 100%
    );
  }
</style>
