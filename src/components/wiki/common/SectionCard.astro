---
import { Card, CardHeader, CardPanel, CardTitle } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import type { NavigationGroup } from "@/config/site";

interface Props {
  group: NavigationGroup;
}

const { group } = Astro.props;
---

<!-- Coss React primitives render to static HTML; this component has no client directive. -->
<Card className="h-full">
  <CardHeader>
    <CardTitle><h2>{group.label}</h2></CardTitle>
  </CardHeader>
  <CardPanel>
    <p class="mb-4">{group.description}</p>
    <ul class="flex flex-wrap gap-2">
      {group.links.map((link) => (
        <li>
          <a
            href={link.path}
            class={buttonVariants({ variant: "outline", size: "default" })}
          >
            {link.title}
          </a>
        </li>
      ))}
    </ul>
  </CardPanel>
</Card>
