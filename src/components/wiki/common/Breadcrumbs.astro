---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: readonly BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((item, index) => (
      <li class="flex min-w-0 items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a
            href={item.href}
            class="rounded-sm underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {item.label}
          </a>
        ) : (
          <span class="break-words text-foreground" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
