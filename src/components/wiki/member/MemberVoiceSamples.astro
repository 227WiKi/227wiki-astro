---
import VoiceSamplePlayer from "@/components/wiki/member/VoiceSamplePlayer";
import { resolveAudioUrl, type VoiceSampleSet } from "@/lib/voice-samples";
import { getMemberThemeStyle } from "@/lib/member-theme";

interface Props {
  voiceSampleSets?: VoiceSampleSet[];
  memberName: string;
  themeColor?: string;
}

const { voiceSampleSets, memberName, themeColor } = Astro.props;
const hasSamples = Boolean(voiceSampleSets && voiceSampleSets.length > 0);
const memberThemeStyle = getMemberThemeStyle(themeColor);

const resolvedSets: VoiceSampleSet[] = hasSamples && voiceSampleSets
  ? voiceSampleSets.map((set) => ({
      ...set,
      samples: set.samples.map((sample) => ({
        ...sample,
        src: resolveAudioUrl(sample.src),
      })),
    }))
  : [];
---

{hasSamples && (
  <section
    id="voice-samples"
    aria-labelledby="voice-samples-heading"
    class="mb-10 w-full min-w-0"
    style={memberThemeStyle}
  >
    <VoiceSamplePlayer
      client:visible
      sets={resolvedSets}
      memberName={memberName}
      themeColor={themeColor}
    />
  </section>
)}
