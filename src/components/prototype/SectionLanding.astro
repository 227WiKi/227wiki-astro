---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sectionPages, type SectionKey } from "@/config/site";
interface Props { sectionKey: SectionKey; }
const section = sectionPages[Astro.props.sectionKey];
---
<BaseLayout title={section.title} description={section.description}>
  <div class="flex flex-col gap-4">
    <h1 class="font-heading text-3xl font-semibold tracking-tight">{section.title}</h1>
    <p class="text-muted-foreground">{section.description}</p>
    <p class="text-sm text-muted-foreground">Content migration will be implemented in a later phase.</p>
  </div>
</BaseLayout>
